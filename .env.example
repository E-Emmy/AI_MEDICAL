# Copy this file to .env.local and fill it in. .env.local is git-ignored; never commit real keys.

# Supabase: Project Settings > API (or the "Connect" button) in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the Python model server runs (see model-server/). This default is right for local work.
MODEL_SERVER_URL=http://127.0.0.1:8000

# Hugging Face access token (huggingface.co > Settings > Access Tokens, "Read" is enough).
# The account must have accepted the terms of google/medsiglip-448.
# The model server reads this file for it, so it only needs to be set here.
HF_TOKEN=hf_your_token
