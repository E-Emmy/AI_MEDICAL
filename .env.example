# Copy this file to .env.local and fill it in. .env.local is git-ignored; never commit real keys.

# Supabase: Project Settings > API (or the "Connect" button) in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the Python model server runs (see model-server/). This default is right for local work.
MODEL_SERVER_URL=http://127.0.0.1:8000
# Hosted model server only (docs/DEPLOYMENT.md). The Gradio Space on ZeroGPU, as "owner/space-name";
# when set, it is used instead of MODEL_SERVER_URL.
# MODEL_SPACE=devYoda/scanlens-models
# A long random string, the same value as MODEL_SERVER_SECRET in the Space's secrets.
# MODEL_SERVER_SECRET=

# Hugging Face access token (huggingface.co > Settings > Access Tokens, "Read" is enough).
# The account must have accepted the terms of google/medsiglip-448.
# Locally the model server reads it from this file. With MODEL_SPACE set, the app also sends it so
# ZeroGPU charges GPU time to this account's daily quota.
HF_TOKEN=hf_your_token
